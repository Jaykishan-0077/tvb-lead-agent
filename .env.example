# Required: used by the agent to read scraped pages and extract structured
# company/contact info.
ANTHROPIC_API_KEY=

# Optional: if set, Google-backed search (via serper.dev) is used instead of
# the free DuckDuckGo backend. Not required to run the agent.
SERPER_API_KEY=

# Optional tuning (defaults live in lead_agent/config.py)
TVB_MAX_DOMAINS=90
TVB_MAX_QUERIES=45
TVB_RESULTS_PER_QUERY=6
TVB_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
